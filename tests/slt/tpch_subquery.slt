# TPC-H queries unlocked by uncorrelated subqueries (H4b), each run VERBATIM
# (sole allowed deviation: ORDER BY on an output ALIAS is unsupported — the
# recorded H4a limitation — so the equivalent aggregate expression is used in
# ORDER BY, exactly as Q13 does) on a hand-checked micro-fixture. Threshold /
# fraction constants are scaled to the micro-fixture (they are TPC-H query
# parameters, not part of the shape under test).

# ===========================================================================
# Q16 — Parts/Supplier Relationship: NOT IN (over a NON-null key set, so it
# behaves normally) + NOT LIKE + IN-list + COUNT(DISTINCT) + multi-key GROUP BY.
# ===========================================================================

statement ok
CREATE TABLE part (p_partkey INT PRIMARY KEY, p_brand VARCHAR(10), p_type VARCHAR(25), p_size INT)

statement ok
CREATE TABLE supplier (s_suppkey INT PRIMARY KEY, s_comment VARCHAR(50))

statement ok
CREATE TABLE partsupp (ps_partkey INT, ps_suppkey INT, PRIMARY KEY (ps_partkey, ps_suppkey))

statement ok
INSERT INTO part VALUES
  (100, 'Brand#12', 'SMALL PLATED', 14),
  (200, 'Brand#45', 'SMALL PLATED', 14),
  (300, 'Brand#12', 'MEDIUM POLISHED STEEL', 14),
  (400, 'Brand#23', 'LARGE BRUSHED', 49)

statement ok
INSERT INTO supplier VALUES
  (1, 'reliable and prompt'),
  (2, 'the Customer never had Complaints until now'),
  (3, 'ships on time')

statement ok
INSERT INTO partsupp VALUES
  (100, 1), (100, 2), (100, 3),
  (400, 1), (400, 3)

# Complaint suppliers (LIKE '%Customer%Complaints%') = {2}; ps_suppkey NOT IN
# {2} keeps suppliers 1 and 3. Part 200 drops (Brand#45), part 300 drops
# (type LIKE 'MEDIUM POLISHED%'). Surviving groups each see suppliers {1,3}
# → COUNT(DISTINCT) = 2.
query TTII
SELECT p_brand, p_type, p_size, COUNT(DISTINCT ps_suppkey)
FROM partsupp, part
WHERE p_partkey = ps_partkey
  AND p_brand <> 'Brand#45'
  AND p_type NOT LIKE 'MEDIUM POLISHED%'
  AND p_size IN (49, 14, 23, 45, 19, 3, 36, 9)
  AND ps_suppkey NOT IN (
    SELECT s_suppkey FROM supplier WHERE s_comment LIKE '%Customer%Complaints%'
  )
GROUP BY p_brand, p_type, p_size
ORDER BY COUNT(DISTINCT ps_suppkey) DESC, p_brand, p_type, p_size
----
Brand#12 SMALL PLATED 14 2
Brand#23 LARGE BRUSHED 49 2

# ===========================================================================
# Q18 — Large Volume Customer: IN over a GROUPED-HAVING subquery (the set is a
# statement constant), a 3-way join, and a 5-key GROUP BY.
# ===========================================================================

statement ok
CREATE TABLE customer (c_custkey INT PRIMARY KEY, c_name VARCHAR(20))

statement ok
CREATE TABLE orders (o_orderkey INT PRIMARY KEY, o_custkey INT, o_orderdate DATE, o_totalprice INT)

statement ok
CREATE TABLE lineitem (l_orderkey INT, l_linenumber INT, l_quantity INT, PRIMARY KEY (l_orderkey, l_linenumber))

statement ok
INSERT INTO customer VALUES (1, 'Alice'), (2, 'Bob')

statement ok
INSERT INTO orders VALUES
  (10, 1, DATE '1995-01-01', 1000),
  (20, 2, DATE '1995-02-01', 2000),
  (30, 1, DATE '1995-03-01', 500)

statement ok
INSERT INTO lineitem VALUES
  (10, 1, 30), (10, 2, 20),
  (20, 1, 40),
  (30, 1, 5)

# The subquery keeps orders whose total quantity > 30: order 10 (50) and order
# 20 (40); order 30 (5) drops. So the IN set is {10, 20}. The outer join then
# reports those two orders, ordered by price DESC.
query TIITII
SELECT c_name, c_custkey, o_orderkey, o_orderdate, o_totalprice, SUM(l_quantity)
FROM customer, orders, lineitem
WHERE o_orderkey IN (
    SELECT l_orderkey FROM lineitem GROUP BY l_orderkey HAVING SUM(l_quantity) > 30
  )
  AND c_custkey = o_custkey
  AND o_orderkey = l_orderkey
GROUP BY c_name, c_custkey, o_orderkey, o_orderdate, o_totalprice
ORDER BY o_totalprice DESC, o_orderdate
----
Bob 2 20 1995-02-01 2000 40
Alice 1 10 1995-01-01 1000 50
