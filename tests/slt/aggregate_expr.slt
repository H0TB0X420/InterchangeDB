# H2a: aggregates over expressions — TPC-H Q1's shape,
# `SUM(l_extendedprice * (1 - l_discount) * (1 + l_tax))`, plus MIN/MAX,
# COUNT, and COUNT(DISTINCT) over arithmetic arguments.
#
# The ship-date filter column `sd` is stubbed as INT until H3 adds a real
# DATE type (see docs/plan-tpch.md); here `sd <= 100` stands in for the
# `l_shipdate <= date '...'` cutoff.
#
# Decimal scales are load-bearing and asserted at exact stored scale (the
# harness prints decimals with an explicit point at their scale):
#   qty/price/disc/tax      scale 2
#   (1 - disc), (1 + tax)   scale 2  (integer literal coerced at bind time)
#   price * (1 - disc)       scale 4  (2 + 2)
#   * (1 + tax)              scale 6  (4 + 2)
#   SUM keeps the argument scale; AVG(Decimal scale 2) stays scale 2.

statement ok
CREATE TABLE li (pk INT PRIMARY KEY, rf CHAR(1), ls CHAR(1), qty DECIMAL(12,2), price DECIMAL(12,2), disc DECIMAL(12,2), tax DECIMAL(12,2), sd INT)

# Two (rf, ls) groups within the cutoff (rows 1-4); rows 5-6 have sd > 100
# and must be filtered out below the aggregate.
statement ok
INSERT INTO li VALUES
  (1, 'A', 'F', 10.00, 100.00, 0.00, 0.00, 50),
  (2, 'A', 'F', 20.00, 200.00, 0.10, 0.00, 60),
  (3, 'N', 'O', 5.00, 50.00, 0.20, 0.10, 70),
  (4, 'N', 'O', 15.00, 40.00, 0.00, 0.05, 90),
  (5, 'A', 'F', 99.00, 999.00, 0.50, 0.50, 200),
  (6, 'N', 'O', 7.00, 70.00, 0.00, 0.00, 101)

# The Q1-shaped query. Hand-computed per group over rows 1-4:
#   ('A','F'): rows 1,2
#     SUM(qty)                     10.00 + 20.00                = 30.00
#     SUM(price)                   100.00 + 200.00              = 300.00
#     SUM(price*(1-disc))          100.0000 + 180.0000          = 280.0000
#     SUM(price*(1-disc)*(1+tax))  100.000000 + 180.000000      = 280.000000
#     AVG(qty)                     30.00 / 2                    = 15.00
#     COUNT(*)                                                  = 2
#   ('N','O'): rows 3,4
#     SUM(qty)                     5.00 + 15.00                 = 20.00
#     SUM(price)                   50.00 + 40.00                = 90.00
#     SUM(price*(1-disc))          40.0000 + 40.0000            = 80.0000
#     SUM(price*(1-disc)*(1+tax))  44.000000 + 42.000000        = 86.000000
#     AVG(qty)                     20.00 / 2                    = 10.00
#     COUNT(*)                                                  = 2
query TTRRRRRI
SELECT rf, ls, SUM(qty), SUM(price), SUM(price * (1 - disc)), SUM(price * (1 - disc) * (1 + tax)), AVG(qty), COUNT(*) FROM li WHERE sd <= 100 GROUP BY rf, ls ORDER BY rf, ls
----
A F 30.00 300.00 280.0000 280.000000 15.00 2
N O 20.00 90.00 80.0000 86.000000 10.00 2

# Ungrouped SUM over an expression: 100.0000 + 180.0000 + 40.0000 + 40.0000.
query R
SELECT SUM(price * (1 - disc)) FROM li WHERE sd <= 100
----
360.0000

# MIN / MAX over the same expression (values 100.0000, 180.0000, 40.0000,
# 40.0000).
query RR
SELECT MIN(price * (1 - disc)), MAX(price * (1 - disc)) FROM li WHERE sd <= 100
----
40.0000 180.0000

# Division inside a grouped SUM. The literal `2` is coerced to Decimal(_,2)
# at bind time, so `price / 2` is an equal-scale division (`div_keeping_scale`
# keeps the dividend's scale 2) — NOT an every-row NULL. Regression guard for
# the Div-scale bug where the type was inferred scale-2 but the runtime NULLed
# on the scale mismatch. Hand-computed per group over rows 1-4:
#   ('A','F'): 100.00/2 = 50.00, 200.00/2 = 100.00 → SUM = 150.00
#   ('N','O'):  50.00/2 = 25.00,  40.00/2 =  20.00 → SUM =  45.00
query TTR
SELECT rf, ls, SUM(price / 2) FROM li WHERE sd <= 100 GROUP BY rf, ls ORDER BY rf, ls
----
A F 150.00
N O 45.00

# A genuinely uninferable division: a scale-2 column over a scale-4 column,
# with no integer literal to coerce, has no equal-scale alignment — so
# `div_keeping_scale` would NULL every row. The schema builder refuses to
# type an accumulator it can't infer and errors loudly (build_aggregate_schema
# → infer_arg_type) rather than silently summing NULL.
statement ok
CREATE TABLE ld (pk INT PRIMARY KEY, a2 DECIMAL(12,2), a4 DECIMAL(12,4))

statement ok
INSERT INTO ld VALUES (1, 1.00, 1.0000)

statement error cannot infer argument type
SELECT SUM(a2 / a4) FROM ld

# A second table with nullable numerics, for NULL-skipping COUNT over an
# expression and COUNT(DISTINCT). v+w is NULL whenever either operand is
# NULL, so those rows are skipped.
statement ok
CREATE TABLE lt (pk INT PRIMARY KEY, v DECIMAL(12,2), w DECIMAL(12,2), name VARCHAR(8))

statement ok
INSERT INTO lt VALUES
  (1, 1.00, 2.00, 'a'),
  (2, NULL, 5.00, 'b'),
  (3, 4.00, NULL, 'c'),
  (4, 10.00, 10.00, 'd'),
  (5, 1.00, 2.00, 'e')

# v+w is non-NULL for rows 1 (3.00), 4 (20.00), 5 (3.00) → 3 values.
query I
SELECT COUNT(v + w) FROM lt
----
3

# Distinct non-NULL values of v+w: {3.00, 20.00} → 2.
query I
SELECT COUNT(DISTINCT v + w) FROM lt
----
2

# Error contract: SUM over a Varchar-typed expression rejects loudly (the
# accumulator can only be numeric).
statement error non-numeric
SELECT SUM(name) FROM lt
