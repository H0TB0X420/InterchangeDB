# TPC-C-shaped end-to-end flows through Session::execute. Converted from
# the single-session tests of tests/it/sql_e2e_test.rs; the multi-session
# tests (snapshot isolation, write conflict) and workload-log integration
# stay in Rust — they need two connections or filesystem assertions.

# ---- tpcc_payment_shape_via_sql -------------------------------------------

statement ok
CREATE TABLE warehouse (w_id INT NOT NULL, w_ytd BIGINT NOT NULL, w_name VARCHAR(10) NOT NULL, PRIMARY KEY (w_id))

statement ok
INSERT INTO warehouse VALUES (1, 1000, 'north'), (2, 2000, 'south')

statement ok
BEGIN

statement ok
UPDATE warehouse SET w_ytd = w_ytd + 100 WHERE w_id = 1

statement ok
UPDATE warehouse SET w_ytd = w_ytd + 50 WHERE w_id = 2

statement ok
COMMIT

query I
SELECT w_ytd FROM warehouse WHERE w_id = 1
----
1100

query I
SELECT w_ytd FROM warehouse WHERE w_id = 2
----
2050

# ---- tpcc_new_order_inserts_multiple_rows ---------------------------------

statement ok
CREATE TABLE order_line (ol_id INT NOT NULL, ol_o_id INT NOT NULL, ol_quantity INT NOT NULL, ol_amount BIGINT NOT NULL, PRIMARY KEY (ol_id))

statement ok
INSERT INTO order_line VALUES (1, 100, 5, 500), (2, 100, 3, 300), (3, 100, 7, 700), (4, 100, 1, 100), (5, 100, 9, 900)

query IIII
SELECT * FROM order_line
----
1 100 5 500
2 100 3 300
3 100 7 700
4 100 1 100
5 100 9 900

query I
SELECT ol_amount FROM order_line WHERE ol_id = 5
----
900

# ---- tpcc_order_status_point_lookup ---------------------------------------

statement ok
CREATE TABLE customer (c_id INT NOT NULL, c_balance BIGINT NOT NULL, c_first VARCHAR(16) NOT NULL, PRIMARY KEY (c_id))

statement ok
INSERT INTO customer VALUES (1, 100, 'alice'), (2, 200, 'bob'), (3, 300, 'carol')

query TI
SELECT c_first, c_balance FROM customer WHERE c_id = 2
----
bob 200

# ---- tpcc_delivery_delete_and_update --------------------------------------

statement ok
CREATE TABLE new_order (no_o_id INT NOT NULL, no_d_id INT NOT NULL, PRIMARY KEY (no_o_id))

statement ok
CREATE TABLE orders (o_id INT NOT NULL, o_carrier_id INT NOT NULL, PRIMARY KEY (o_id))

statement ok
INSERT INTO new_order VALUES (1, 1), (2, 1), (3, 1)

statement ok
INSERT INTO orders VALUES (1, 0), (2, 0), (3, 0)

statement ok
BEGIN

statement ok
DELETE FROM new_order WHERE no_o_id = 1

statement ok
UPDATE orders SET o_carrier_id = 7 WHERE o_id = 1

statement ok
COMMIT

query II
SELECT * FROM new_order WHERE no_o_id = 1
----

query I
SELECT o_carrier_id FROM orders WHERE o_id = 1
----
7

# ---- rollback_via_sql_discards_all_writes ---------------------------------

statement ok
CREATE TABLE t (id INT NOT NULL, n BIGINT NOT NULL, PRIMARY KEY (id))

statement ok
BEGIN

statement ok
INSERT INTO t VALUES (1, 100), (2, 200)

statement ok
UPDATE t SET n = 999 WHERE id = 1

statement ok
ROLLBACK

query II
SELECT * FROM t
----

# ---- read_your_own_writes_within_explicit_txn -----------------------------

statement ok
BEGIN

statement ok
INSERT INTO t VALUES (1, 100)

query I
SELECT n FROM t WHERE id = 1
----
100

statement ok
UPDATE t SET n = 200 WHERE id = 1

query I
SELECT n FROM t WHERE id = 1
----
200

statement ok
COMMIT

# ---- int32_column_increment_via_sql ---------------------------------------

statement ok
CREATE TABLE district (d_id INT NOT NULL, d_next_o_id INT NOT NULL, PRIMARY KEY (d_id))

statement ok
INSERT INTO district VALUES (1, 3001)

statement ok
UPDATE district SET d_next_o_id = d_next_o_id + 1 WHERE d_id = 1

statement ok
UPDATE district SET d_next_o_id = d_next_o_id + 1 WHERE d_id = 1

query I
SELECT d_next_o_id FROM district WHERE d_id = 1
----
3003

# ---- explain_select_with_where_renders_tree -------------------------------
# Non-PK predicate keeps scan + filter; the harness renders EXPLAIN output
# one trimmed line per row, so this pins the full operator tree in order.

query T
EXPLAIN SELECT n FROM t WHERE n = 1
----
Projection([1])
Filter
SeqScan(t)
