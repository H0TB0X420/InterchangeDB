# Derived tables (FROM-subqueries, uncorrelated) — H4a.
#
# A derived table binds its inner query in a fresh scope, computes its output
# schema (types + captured `AS` names / a column-list alias), and materializes
# it as a `DerivedScan` leaf. The outer WHERE / GROUP BY / aggregates then
# resolve over the derived columns exactly like a catalog table's — that
# uniformity is the whole point (Q7's `l_year` is a plain column OF the derived
# table, not an expression the outer query re-derives).

statement ok
CREATE TABLE emp (e_id INT PRIMARY KEY, dept INT, salary INT, hired DATE)

statement ok
CREATE TABLE dept (d_id INT PRIMARY KEY, d_name VARCHAR(10))

statement ok
INSERT INTO emp VALUES
  (1, 10, 100, DATE '1995-01-01'),
  (2, 10, 200, DATE '1995-06-01'),
  (3, 20, 300, DATE '1996-01-01'),
  (4, 20, 400, DATE '1996-06-01'),
  (5, 30, 500, DATE '1997-01-01')

statement ok
INSERT INTO dept VALUES (10, 'eng'), (20, 'sales'), (30, 'ops')

# ---- basic derived scan: a subquery in FROM behaves like the table ----------
query II
SELECT e_id, salary FROM (SELECT e_id, salary FROM emp) AS d ORDER BY e_id
----
1 100
2 200
3 300
4 400
5 500

# ---- plan shape: a derived leaf lowers to DerivedScan(alias) + subplan ------
# The header names the alias; the inner query renders indented one level. No
# predicate pushdown into the subplan, no index paths (recorded lever).
query T
EXPLAIN SELECT e_id, salary FROM (SELECT e_id, salary FROM emp) AS d ORDER BY e_id
----
Projection([0, 1])
Sort[0 ASC]
DerivedScan(d)
Projection([0, 2])
SeqScan(emp)

# ---- aliased expression column, grouped on it in the OUTER query ------------
# `EXTRACT(YEAR FROM hired) AS yr` is a computed column of the derived table;
# the outer query groups by `yr` as a plain column (Q7's l_year shape).
query II
SELECT yr, COUNT(*) FROM (SELECT EXTRACT(YEAR FROM hired) AS yr FROM emp) AS d
  GROUP BY yr ORDER BY yr
----
1995 2
1996 2
1997 1

# ---- column-list alias `AS d (g, s)` — positional rename of every column ----
query II
SELECT g, s FROM (SELECT dept, SUM(salary) FROM emp GROUP BY dept) AS d (g, s)
  ORDER BY g
----
10 300
20 700
30 500

# ---- outer WHERE + GROUP BY + aggregates over derived columns ---------------
# The WHERE (`s >= 200`) filters the derived output ABOVE the DerivedScan; the
# outer GROUP BY / COUNT / SUM run over the derived columns g and s.
query III
SELECT g, COUNT(*), SUM(s) FROM (SELECT dept, salary AS s FROM emp) AS d (g, s)
  WHERE s >= 200 GROUP BY g ORDER BY g
----
10 1 200
20 2 700
30 1 500

# ---- a derived table CONTAINING a join --------------------------------------
# The inner query joins emp and dept and aggregates; the outer reads the
# result. The join lives entirely inside the DerivedScan's subplan.
query TI
SELECT dname, total FROM (
  SELECT d_name, SUM(salary) FROM emp JOIN dept ON dept = d_id GROUP BY d_name
) AS d (dname, total) ORDER BY dname
----
eng 300
ops 500
sales 700

# ---- error contracts --------------------------------------------------------
# LATERAL is correlated — out of scope for uncorrelated H4a.
statement error LATERAL derived tables not supported
SELECT * FROM emp, LATERAL (SELECT e_id FROM emp) AS d

# A derived table needs an alias to name its columns by.
statement error requires an alias
SELECT * FROM (SELECT e_id FROM emp)

# A column list must name every output column — a count mismatch is loud.
statement error column list has 1 names but the subquery produces 2 columns
SELECT * FROM (SELECT e_id, salary FROM emp) AS d (only_one)

# Derived tables nested deeper than MAX_DERIVED_DEPTH (4) are rejected.
statement error nested deeper than 4 levels
SELECT * FROM (SELECT * FROM (SELECT * FROM (SELECT * FROM (SELECT * FROM (
  SELECT e_id FROM emp) AS d5) AS d4) AS d3) AS d2) AS d1

# ---- duplicate FROM relation names (silent wrong results) -------------------
# Two derived tables sharing an alias: the binder resolves per first-match
# schema while the planner's leaf map is last-insert-wins, so every ref to `d`
# reads the SECOND subquery — both output columns came from it. Reject the
# duplicate exposed name loudly.
statement error specified more than once in FROM
SELECT * FROM (SELECT e_id FROM emp) AS d, (SELECT salary FROM emp) AS d

# A derived alias colliding with a table's alias is the same error — a derived
# table is just another exposed relation name in the FROM scope.
statement error specified more than once in FROM
SELECT * FROM emp AS d, (SELECT e_id FROM emp) AS d

# Two catalog tables sharing an alias — rejected too. Pre-H4a this was silently
# accepted and a qualified `d.col` resolved to the first table (first match).
statement error specified more than once in FROM
SELECT * FROM emp AS d, dept AS d

# Single-alias catalog shadowing STAYS legal: a derived table may take a
# catalog table's name (`emp`) when it is the only relation so named — that is
# one relation called `emp`, not two.
query II
SELECT e_id, salary FROM (SELECT e_id, salary FROM emp) AS emp ORDER BY e_id
----
1 100
2 200
3 300
4 400
5 500

# ===========================================================================
# H4d — subqueries INSIDE a derived table.
#
# A derived table's inner Select may now carry its OWN scalar / IN / correlated
# subqueries. The session's subquery resolution recurses into `derived`
# bottom-up: each derived Select's subqueries resolve/materialize/evaluate
# against the same statement engine handle before its DerivedScan runs. The
# per-Select slot namespaces stay apart — scalar results are baked per-plan;
# the IN/correlated global slices append each derived's after the enclosing
# Select's own.
# ===========================================================================

# A department with no employees, to make the correlated-EXISTS discriminating.
statement ok
INSERT INTO dept VALUES (40, 'hr')

# ---- derived table with its own SCALAR subquery ----------------------------
# The inner query's WHERE compares against an uncorrelated scalar AVG:
# AVG(salary) over emp = (100+200+300+400+500)/5 = 300.0000; salary > 300 keeps
# 400 and 500. The scalar is resolved (run + spliced as a literal) INSIDE the
# derived plan before its DerivedScan runs.
query I
SELECT hi FROM (SELECT salary AS hi FROM emp WHERE salary > (SELECT AVG(salary) FROM emp)) AS d
  ORDER BY hi
----
400
500

# ---- derived table with its own correlated EXISTS (its OWN scope) ----------
# The NOT-yet: EXISTS correlates to the derived's own FROM (`dept`), one level,
# fully inside the inner Select — `emp.dept = d_id` binds `d_id` to the derived
# plan's own `dept` row (H4c machinery, one level down). Depts 10/20/30 have
# employees; dept 40 ('hr') has none, so it is excluded.
query T
SELECT dname FROM (
  SELECT d_name AS dname FROM dept WHERE EXISTS (SELECT * FROM emp WHERE dept = d_id)
) AS d ORDER BY dname
----
eng
ops
sales

# ---- TWO derived tables, EACH with its own scalar subquery (namespace) ------
# Both derived plans use `SubqueryResult(0)` into their OWN `scalar_subqueries`
# list — identically numbered, DIFFERENT queries. Per-plan baking resolves each
# against its own value (MAX=500 for `a`, MIN=100 for `b`), so the slots never
# collide. `a` keeps salary >= 500 → {500}; `b` keeps salary <= 100 → {100}.
query II
SELECT a.hi, b.lo FROM
  (SELECT salary AS hi FROM emp WHERE salary >= (SELECT MAX(salary) FROM emp)) AS a,
  (SELECT salary AS lo FROM emp WHERE salary <= (SELECT MIN(salary) FROM emp)) AS b
----
500 100

# ---- correlation from INSIDE a derived table to the OUTER statement: reject -
# A subquery inside the derived `sub` references `outer_e.e_id` — a column of
# the OUTER statement, two levels out from the EXISTS. The derived table is
# bound in a FRESH scope (no enclosing columns), so `outer_e` is not visible
# inside it: the reference is a loud "not in FROM scope" (unchanged contract).
statement error not in FROM scope
SELECT e_id FROM emp AS outer_e, (
  SELECT d_id FROM dept WHERE EXISTS (SELECT * FROM emp WHERE emp.dept = outer_e.e_id)
) AS sub

# ---- runtime subqueries on BOTH sides of the derived boundary: reject -------
# The outer query filters on a correlated EXISTS AND the derived table filters
# on its own correlated EXISTS — two runtime sources whose 0-based slots would
# collide in the statement-global slice. Renumbering is a recorded lever, so
# this is a loud rejection rather than a mis-indexed slice (never silent wrong
# results).
statement error correlated subqueries in BOTH a derived table and its enclosing
SELECT e_id FROM emp,
  (SELECT d_id FROM dept d1 WHERE EXISTS (SELECT * FROM emp e2 WHERE e2.dept = d1.d_id)) AS sub
WHERE EXISTS (SELECT * FROM dept d3 WHERE d3.d_id = emp.dept)

# ---- EXPLAIN of a Q22-shaped statement (subquery buried in the derived) ------
# The outer SELECT carries NO subqueries of its own — the scalar AVG lives
# entirely inside the derived `d`. EXPLAIN recurses into `derived` to render the
# subquery trailer; `(in d)` names the derived table it belongs to (before this
# recursion EXPLAIN was blind to it and emitted no trailer at all). The scalar
# is a resolved literal at run time, but EXPLAIN plans the raw template, so the
# trailer shows the AVG aggregate plan.
query T
EXPLAIN SELECT hi FROM
  (SELECT salary AS hi FROM emp WHERE salary > (SELECT AVG(salary) FROM emp)) AS d
  ORDER BY hi
----
Projection([0])
Sort[0 ASC]
DerivedScan(d)
Projection([2])
Filter
SeqScan(emp)
Subquery[0] (in d):
HashAggregate[AVG(c2)]
SeqScan(emp)

# ---- derived-INSIDE-derived with a runtime IN at the INNER level ------------
# Two nested derived tables; only the innermost carries a runtime subquery
# (`dept IN (SELECT d_id ... WHERE d_name = 'eng')`). 'eng' is d_id 10, whose
# employees are e_id 1 (salary 100) and 2 (salary 200) — the single-source slot
# space stays uncollided, so the IN materializes and filters cleanly.
query I
SELECT x FROM (
  SELECT hi AS x FROM (
    SELECT salary AS hi FROM emp WHERE dept IN (SELECT d_id FROM dept WHERE d_name = 'eng')
  ) AS d1
) AS d0 ORDER BY x
----
100
200

# ---- runtime subqueries at BOTH derived levels: reject ----------------------
# The inner derived `d1` carries an IN AND its enclosing derived `d0` carries
# its own IN — two runtime sources whose 0-based slots would collide in the
# statement-global slice. Same recorded-lever rejection as the outer/derived
# case above, one level deeper (never a mis-indexed slice).
statement error IN/EXISTS subqueries in BOTH a derived table
SELECT x FROM (
  SELECT hi AS x FROM (
    SELECT salary AS hi FROM emp WHERE dept IN (SELECT d_id FROM dept WHERE d_name = 'eng')
  ) AS d1
  WHERE hi IN (SELECT salary FROM emp WHERE dept = 10)
) AS d0 ORDER BY x
